# Front-end settings (Vite exposes only VITE_* variables to the browser).

# true  = run fully in the browser with demo data (no backend needed)
# false = call the Laravel API under VITE_API_BASE_URL
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=/api

# Minutes of inactivity before the "Are you still there?" warning.
VITE_IDLE_TIMEOUT_MIN=15
