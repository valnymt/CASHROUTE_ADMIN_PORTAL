# CashRoute HQ Admin — frontend settings. Copy to .env and adjust.
# Vite only exposes variables that start with VITE_. Rebuild after changing.

# true  = run fully in the browser with demo data (no backend needed)
# false = call the Laravel backend at VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# Laravel backend API (only used when VITE_USE_MOCK_API=false).
# Example for XAMPP: http://localhost/CashRoute/Cashroute_backend/public/api
VITE_API_BASE_URL=http://localhost/CashRoute/Cashroute_backend/public/api

# false = open any page without signing in (demo mode, signs in as Admin User)
# true  = always show the login screen first (demo login: admin.maker / password)
VITE_REQUIRE_LOGIN=false

# Minutes of inactivity before the "Are you still there?" warning.
VITE_IDLE_TIMEOUT_MIN=15

# URL path of the *built* app (npm run build). Must start and end with "/".
# "/" for any web root; for XAMPP serving dist/ from this folder use:
VITE_BASE_PATH=/CashRoute/CashRoute_Admin_Portal/dist/
