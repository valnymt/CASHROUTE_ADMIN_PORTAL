# dependencies
node_modules/

# build output — dist/ IS committed so teammates can open the app through XAMPP
# without installing anything. Run `npm run build` before committing UI changes.
*.tsbuildinfo

# environment (copy .env.example to .env)
.env
.env.*
!.env.example
# .env.production holds the public settings used by `npm run build` so the
# committed dist/ is identical for everyone (no secrets, safe to track).
!.env.production

# logs
*.log
npm-debug.log*

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# local tool settings
.claude/
