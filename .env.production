# Settings used by `npm run build` (overrides local .env, committed to git).
# This fixes the dist/ bundle served from XAMPP so every teammate's build is
# identical regardless of their local .env.
#
# Set VITE_USE_MOCK_API=true here only if you want the committed dist/ to run
# fully in the browser (useful if your mentor can't start the backend).

VITE_USE_MOCK_API=false
VITE_API_BASE_URL=http://localhost/CashRoute/Cashroute_backend/public/api
VITE_REQUIRE_LOGIN=false
VITE_IDLE_TIMEOUT_MIN=15
VITE_BASE_PATH=/CashRoute/CashRoute_Admin_Portal/dist/
